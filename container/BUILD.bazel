load("@rules_go//go:def.bzl", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

pkg_tar(
    name = "weft_tar",
    srcs = ["//:weft"],
    package_dir = "/usr/bin",
)

pkg_tar(
    name = "weft_tar_arm64",
    srcs = ["//:weft_arm64"],
    package_dir = "/usr/bin",
)

oci_image(
    name = "weft_image_amd64",
    base = "@alpine_linux_amd64",
    entrypoint = ["/usr/bin/weft"],
    tars = [":weft_tar"],
)

oci_image(
    name = "weft_image_arm64_v8",
    base = "@alpine_linux_arm64_v8",
    entrypoint = ["/usr/bin/weft_arm64"],
    tars = [":weft_tar_arm64"],
)

oci_image_index(
    name = "weft_image",
    images = [
        ":weft_image_amd64",
        ":weft_image_arm64_v8",
    ],
)

oci_push(
    name = "weft_image_push",
    image = ":weft_image",
    remote_tags = ["latest"],
    repository = "ghcr.io/aquaduct-dev/weft",
)

# Offline check of what weft_image_push publishes: reads the built OCI layouts
# and verifies each platform's config architecture, entrypoint, and that the
# entrypoint binary in the layers is an ELF for the right machine type.
go_test(
    name = "container_test",
    srcs = ["image_test.go"],
    args = [
        "-amd64_layout=$(rootpath :weft_image_amd64)",
        "-arm64_layout=$(rootpath :weft_image_arm64_v8)",
        "-index_layout=$(rootpath :weft_image)",
    ],
    data = [
        ":weft_image",
        ":weft_image_amd64",
        ":weft_image_arm64_v8",
    ],
)
